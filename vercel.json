{
  "buildCommand": "uv pip install -r requirements.txt --system",
  "installCommand": "uv pip install -r requirements.txt --system",
  "framework": null,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {"runtime": "python3.11"}
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
